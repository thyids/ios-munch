+/*
+ * SWEET: Focaltech FTS (FT3658U) touch on the K40S (munch / SM8250).
+ *
+ * The K40S wires its FTS controller to GENI SE4 configured for SPI (device
+ * tree: soc/spi@990000/focaltech@0, pinctrl qupv3_se4_spi_active = gpio8..11,
+ * reset = gpio33, irq = gpio39, vddio = gpio69).
+ *
+ * On SM8250 (qcom,kona-pinctrl), TLMM at 0x0f000000 is 16 MiB and tiled:
+ *   WEST  = 0x00100000
+ *   SOUTH = 0x00500000 (gpio33, 38, 39, 69)
+ *   NORTH = 0x00900000 (gpio8, 9, 10, 11)
+ *
+ * Wire protocol (drivers/input/touchscreen/focaltech_spi):
+ *   write: [addr][0x00][len>>8][len][3 dummy][data...]          status = rx[3]
+ *   read : [addr][0xA0][len>>8][len][3 dummy][data...][crc16]   status = rx[3]
+ *          data at rx[7]; CRC16-KERMIT over data[0..len-1] (low byte first)
+ *   ok when (rx[3] & 0xA0) == 0
+ * Registers: 0x01 touch report (62 bytes), 0xA3 chip id high, 0x9F chip id low,
+ *            0xA6 firmware version.
+ *
+ * Boot-arg sweetft=1 enables it (default off: other boards are untouched).
+ */
+#if defined(ARM64_BOARD_CONFIG_SWEET)
+#include <sys/param.h>
+#include <sys/systm.h>
+#include <sys/errno.h>
+#include <kern/clock.h>
+#include <kern/thread.h>
+#include <kern/sched_prim.h>
+#include <machine/machine_routines.h>
+#include <pexpert/pexpert.h>
+
+extern vm_offset_t ml_io_map(vm_offset_t, vm_size_t);
+extern kern_return_t thread_terminate(thread_t);
+extern void sweet_hid_touch(int finger, int down, int x, int y);
+extern int sweet_rpmh_vreg_enable(const char *res, unsigned mv);
+void sweet_ft_init(void);
+
+#define FT_TLMM_PA        0x0f000000u   /* SM8250 TLMM, DT soc/pinctrl@f000000 */
+#define FT_TLMM_SIZE      0x01000000u   /* 16 MiB covering WEST/SOUTH/NORTH */
+#define FT_TILE_WEST      0x00100000u
+#define FT_TILE_SOUTH     0x00500000u
+#define FT_TILE_NORTH     0x00900000u
+
+#define FT_SE_PA          0x00990000u   /* GENI SE4, DT soc/spi@990000 */
+#define FT_SE_FW_REV      0x068u
+#define FT_SE_STATUS      0x040u
+#define FT_SE_M_CMD       0x0600u
+#define FT_SE_M_CMD_CTRL  0x0604u
+#define FT_SE_M_IRQ       0x0610u
+#define FT_SE_M_IRQ_CLR   0x0618u
+#define FT_SE_DMA_MODE    0x0258u
+#define FT_SE_CLK_SEL     0x07cu
+
+#define FT_PULL_NONE      0u            /* MSM_NO_PULL */
+#define FT_PULL_DOWN      1u            /* MSM_PULL_DOWN */
+#define FT_PULL_UP        3u            /* MSM_PULL_UP */
+
+#define FT_PIN_A          8u            /* qupv3_se4_spi_active = gpio8..11 (NORTH) */
+#define FT_PIN_B          9u
+#define FT_PIN_C          10u
+#define FT_PIN_D          11u
+#define FT_PIN_RESET      33u           /* focaltech,reset-gpio (SOUTH) */
+#define FT_PIN_RESET_ALT  38u           /* pmx_ts_active alternate reset (SOUTH) */
+#define FT_PIN_IRQ        39u           /* focaltech,irq-gpio (SOUTH) */
+#define FT_PIN_VDDIO      69u           /* touch_vddio_vreg (SOUTH) */
+
+#define FT_REG_TOUCH      0x01u         /* focaltech_spi reads touch from 0x01 */
+#define FT_REG_CHIP_ID2   0x9fu
+#define FT_REG_CHIP_ID    0xa3u
+#define FT_REG_FW_VER     0xa6u
+#define FT_TOUCH_LEN      62u           /* FTS_TOUCH_DATA_LEN (63) - 1 */
+#define FT_MAX_FINGERS    10u
+
+#define FT_HDR_LEN        7u            /* addr, cmd, len hi/lo, 3 dummy */
+#define FT_CS_DELAY_US    150u
+
+struct ft_pins {
+	unsigned clk, mosi, miso, cs;
+};
+
+static struct {
+	vm_offset_t tlmm, se;
+	bool started, ready;
+	struct ft_pins pins;
+	uint32_t active;
+	int x[FT_MAX_FINGERS], y[FT_MAX_FINGERS];
+	unsigned ok, fail, probe_fails, touch_logs;
+} ft;
+
+/* 0 = SPI mode 0 (CPOL0/CPHA0), 1 = mode 3 (CPOL1/CPHA1) */
+static int ft_spi_mode;
+static uint8_t ft_last_st, ft_last_d0;
+static uint16_t ft_last_want, ft_last_got;
+static int ft_sleep_chan;
+
+static inline uint32_t
+ft_pin_tile(unsigned pin)
+{
+	/* From pinctrl-kona.c: gpio8..11 are NORTH; gpio33,38,39,69 are SOUTH. */
+	if (pin <= 23u) {
+		return FT_TILE_NORTH;
+	}
+	return FT_TILE_SOUTH;
+}
+
+static inline uint32_t
+ft_cfg_off(unsigned pin)
+{
+	return ft_pin_tile(pin) + (uint32_t)pin * 0x1000u;
+}
+
+static inline uint32_t
+ft_io_off(unsigned pin)
+{
+	return ft_cfg_off(pin) + 4u;
+}
+
+static inline uint32_t
+ft_ctl_off(unsigned pin)
+{
+	return ft_cfg_off(pin) + 8u;
+}
+
+static inline void
+ft_pin_out(unsigned pin, int high)
+{
+	uint32_t off = ft_io_off(pin);
+	uint32_t v = high ? 2u : 0u; /* out_bit = 1 */
+	*(volatile uint32_t *)(ft.tlmm + off) = v;
+	__asm__ volatile("dmb oshst" ::: "memory");
+}
+
+static inline int
+ft_pin_in(unsigned pin)
+{
+	uint32_t v = *(volatile uint32_t *)(ft.tlmm + ft_io_off(pin));
+	__asm__ volatile("dmb oshld" ::: "memory");
+	return (v & 1u) ? 1 : 0; /* in_bit = 0 */
+}
+
+/* Mux a pad to plain GPIO (func=0). pinctrl-kona.c: pull<<0 | func<<2 |
+ * drive<<6 | oe<<9, plus egpio_enable(12) if egpio_present(11) is set. */
+static void
+ft_pad(unsigned pin, int dir_out, unsigned pull)
+{
+	uint32_t off = ft_cfg_off(pin);
+	uint32_t cfg = *(volatile uint32_t *)(ft.tlmm + off);
+	cfg &= ~0x3ffu;
+	cfg |= (pull & 3u) | (3u << 6) | (dir_out ? 0x200u : 0u);
+	if (cfg & (1u << 11)) {
+		cfg |= (1u << 12);
+	}
+	*(volatile uint32_t *)(ft.tlmm + off) = cfg;
+	__asm__ volatile("dmb oshst" ::: "memory");
+}
+
+static inline uint32_t
+ft_se_rd(uint32_t off)
+{
+	uint32_t v = *(volatile uint32_t *)(ft.se + off);
+	__asm__ volatile("dmb oshld" ::: "memory");
+	return v;
+}
+
+static inline void
+ft_se_wr(uint32_t off, uint32_t v)
+{
+	*(volatile uint32_t *)(ft.se + off) = v;
+	__asm__ volatile("dmb oshst" ::: "memory");
+}
+
+/* Take the pads away from QUP: abort any command, drop DMA, clear IRQs. */
+static void
+ft_se_quiesce(void)
+{
+	uint32_t fw = ft_se_rd(FT_SE_FW_REV), st = ft_se_rd(FT_SE_STATUS);
+	uint32_t cmd = ft_se_rd(FT_SE_M_CMD);
+	printf("SWEET FT: SE4 fw=%#x proto=%u status=%#x m_cmd=%#x clk_sel=%#x dma=%#x\n",
+	    fw, (fw >> 8) & 0xffu, st, cmd, ft_se_rd(FT_SE_CLK_SEL),
+	    ft_se_rd(FT_SE_DMA_MODE));
+	ft_se_wr(FT_SE_DMA_MODE, 0);
+	ft_se_wr(FT_SE_M_CMD_CTRL, 2);          /* abort M command */
+	for (unsigned i = 0; i < 2000; ++i) {
+		if (ft_se_rd(FT_SE_M_IRQ) & (1u << 5)) {
+			break;
+		}
+		delay(1);
+	}
+	ft_se_wr(FT_SE_M_IRQ_CLR, 0xffffffffu);
+	printf("SWEET FT: SE4 quiesced status=%#x irq=%#x\n",
+	    ft_se_rd(FT_SE_STATUS), ft_se_rd(FT_SE_M_IRQ));
+}
+
+static void
+ft_bus_levels(const char *when)
+{
+	ft_pad(ft.pins.miso, 0, FT_PULL_UP);
+	delay(100);
+	int up = ft_pin_in(ft.pins.miso);
+	ft_pad(ft.pins.miso, 0, FT_PULL_DOWN);
+	delay(100);
+	int down = ft_pin_in(ft.pins.miso);
+	ft_pad(ft.pins.miso, 0, FT_PULL_UP);
+	int irq = ft_pin_in(FT_PIN_IRQ);
+	int rst = ft_pin_in(FT_PIN_RESET);
+	printf("SWEET FT: %s miso(up)=%d miso(dn)=%d irq=%d reset=%d\n",
+	    when, up, down, irq, rst);
+}
+
+static void
+ft_pad_report(const char *tag, unsigned pin)
+{
+	uint32_t cfg = *(volatile uint32_t *)(ft.tlmm + ft_cfg_off(pin));
+	uint32_t io = *(volatile uint32_t *)(ft.tlmm + ft_io_off(pin));
+	uint32_t ctl = *(volatile uint32_t *)(ft.tlmm + ft_ctl_off(pin));
+	__asm__ volatile("dmb oshld" ::: "memory");
+	printf("SWEET FT: %s gpio%u(off=%#x) cfg=%#x io=%#x ctl=%#x\n",
+	    tag, pin, ft_cfg_off(pin), cfg, io, ctl);
+}
+
+static void
+ft_tlmm_selftest(void)
+{
+	printf("SWEET FT: TLMM at %#llx, tiled self-test\n", (unsigned long long)ft.tlmm);
+	ft_pad_report("raw-before", FT_PIN_RESET);
+	ft_pad_report("raw-before", FT_PIN_IRQ);
+	ft_pad_report("raw-before", FT_PIN_VDDIO);
+	for (unsigned p = 8; p <= 11; ++p) {
+		ft_pad_report("raw-before", p);
+	}
+
+	ft_pad(FT_PIN_RESET, 1, FT_PULL_NONE);
+	ft_pin_out(FT_PIN_RESET, 1);
+	delay(5);
+	ft_pad_report("drive-hi", FT_PIN_RESET);
+	ft_pin_out(FT_PIN_RESET, 0);
+	delay(5);
+	ft_pad_report("drive-lo", FT_PIN_RESET);
+
+	ft_pad(8, 1, FT_PULL_NONE);
+	ft_pin_out(8, 1);
+	delay(5);
+	ft_pad_report("drive-hi", 8);
+	ft_pin_out(8, 0);
+	delay(5);
+	ft_pad_report("drive-lo", 8);
+}
+
+/* One byte, MSB first. */
+static uint8_t
+ft_spi_byte(uint8_t out)
+{
+	uint8_t in = 0;
+	int idle = ft_spi_mode ? 1 : 0;
+	for (int bit = 7; bit >= 0; --bit) {
+		ft_pin_out(ft.pins.mosi, (out >> bit) & 1u);
+		delay(1);
+		ft_pin_out(ft.pins.clk, idle ? 0 : 1);
+		delay(1);
+		in = (uint8_t)((in << 1) | (ft_pin_in(ft.pins.miso) ? 1u : 0u));
+		ft_pin_out(ft.pins.clk, idle ? 1 : 0);
+		delay(1);
+	}
+	return in;
+}
+
+static void
+ft_spi_xfer(const uint8_t *tx, uint8_t *rx, unsigned len)
+{
+	int idle = ft_spi_mode ? 1 : 0;
+	ft_pin_out(ft.pins.clk, idle);
+	ft_pin_out(ft.pins.cs, 0);
+	delay(2);
+	for (unsigned i = 0; i < len; ++i) {
+		uint8_t v = ft_spi_byte(tx ? tx[i] : 0x00u);
+		if (rx) {
+			rx[i] = v;
+		}
+	}
+	delay(2);
+	ft_pin_out(ft.pins.cs, 1);
+	delay(FT_CS_DELAY_US);
+}
+
+static uint16_t
+ft_crc16(const uint8_t *p, unsigned len)
+{
+	uint16_t crc = 0xffffu;
+	for (unsigned i = 0; i < len; ++i) {
+		crc ^= p[i];
+		for (int j = 0; j < 8; ++j) {
+			crc = (crc & 1u) ? (uint16_t)((crc >> 1) ^ 0x8408u) :
+			    (uint16_t)(crc >> 1);
+		}
+	}
+	return crc;
+}
+
+static int
+ft_read_reg(uint8_t addr, uint8_t *data, unsigned len)
+{
+	uint8_t tx[FT_HDR_LEN + 128 + 2], rx[FT_HDR_LEN + 128 + 2];
+	if (len > 128) {
+		return EINVAL;
+	}
+	unsigned txlen = FT_HDR_LEN + len + 2;
+	for (int retry = 0; retry < 3; ++retry) {
+		memset(tx, 0, txlen);
+		memset(rx, 0, txlen);
+		tx[0] = addr;
+		tx[1] = 0xa0u;                  /* READ_CMD (0x80) | DATA_CRC_EN (0x20) */
+		tx[2] = (uint8_t)(len >> 8);
+		tx[3] = (uint8_t)len;
+		ft_spi_xfer(tx, rx, txlen);
+		ft_last_st = rx[3];
+		ft_last_d0 = rx[FT_HDR_LEN];
+		if ((rx[3] & 0xa0u) != 0u) {
+			delay(FT_CS_DELAY_US);
+			continue;
+		}
+		uint16_t want = ft_crc16(&rx[FT_HDR_LEN], len);
+		uint16_t got = (uint16_t)(rx[FT_HDR_LEN + len] |
+		    ((uint16_t)rx[FT_HDR_LEN + len + 1] << 8));
+		ft_last_want = want;
+		ft_last_got = got;
+		memcpy(data, &rx[FT_HDR_LEN], len);
+		if (want == got) {
+			return 0;
+		}
+		delay(FT_CS_DELAY_US);
+	}
+	return EIO;
+}
+
+/* Rails (device tree): vdd = pm8150a-l10 (3200 mV in focaltech_core.c),
+ * vcc_i2c = pm8150a-l1 (1800 mV), disp_vddio_vreg = TLMM gpio69. */
+static void
+ft_power(void)
+{
+	ft_pad(FT_PIN_RESET, 1, FT_PULL_NONE);
+	ft_pin_out(FT_PIN_RESET, 0);
+	ft_pad(FT_PIN_RESET_ALT, 1, FT_PULL_NONE);
+	ft_pin_out(FT_PIN_RESET_ALT, 0);
+	ft_pad(FT_PIN_IRQ, 0, FT_PULL_UP);
+	delay(2000);
+
+	int e1 = sweet_rpmh_vreg_enable("ldoc1", 1800);
+	ft_pad(FT_PIN_VDDIO, 1, FT_PULL_NONE);
+	ft_pin_out(FT_PIN_VDDIO, 1);
+	delay(2000);
+
+	int e10 = sweet_rpmh_vreg_enable("ldoc10", 3200);
+	printf("SWEET FT: rails ldoc10=%d ldoc1=%d, vddio gpio%u high\n",
+	    e10, e1, FT_PIN_VDDIO);
+	delay(10000);
+}
+
+static void
+ft_reset(unsigned wait_ms)
+{
+	ft_pin_out(FT_PIN_RESET, 0);
+	ft_pin_out(FT_PIN_RESET_ALT, 0);
+	delay(2000);
+	ft_pin_out(FT_PIN_RESET, 1);
+	ft_pin_out(FT_PIN_RESET_ALT, 1);
+	delay(wait_ms * 1000u);
+}
+
+static bool
+ft_probe_pins(struct ft_pins p, unsigned wait_ms, int retries)
+{
+	uint8_t id = 0, id2 = 0, fw = 0;
+	ft.pins = p;
+	ft_pad(p.clk, 1, FT_PULL_NONE);
+	ft_pad(p.mosi, 1, FT_PULL_NONE);
+	ft_pad(p.cs, 1, FT_PULL_NONE);
+	ft_pad(p.miso, 0, FT_PULL_UP);
+	ft_pin_out(p.clk, 0);
+	ft_pin_out(p.cs, 1);
+
+	ft_reset(wait_ms);
+	if (ft.probe_fails < 3) {
+		ft_bus_levels("after reset");
+	}
+	for (int attempt = 0; attempt < retries; ++attempt) {
+		for (int mode = 0; mode < 2; ++mode) {
+			ft_spi_mode = mode;
+			int err = ft_read_reg(FT_REG_CHIP_ID, &id, 1);
+			if (err == 0 && id != 0x00u && id != 0xffu) {
+				goto found;
+			}
+			/* Accept a known FT3658U id (0x56/0x36/0x88) even if CRC mismatched */
+			if ((ft_last_st & 0xa0u) == 0u &&
+			    (ft_last_d0 == 0x56u || ft_last_d0 == 0x36u || ft_last_d0 == 0x88u)) {
+				id = ft_last_d0;
+				goto found;
+			}
+			id = 0;
+		}
+		if (attempt + 1 < retries) {
+			delay(50000);
+		}
+	}
+	if (ft.probe_fails++ < 8) {
+		printf("SWEET FT: try clk=%u mosi=%u miso=%u cs=%u -> "
+		    "st=%#x d0=%#x crc=%#x/%#x (no id)\n",
+		    p.clk, p.mosi, p.miso, p.cs,
+		    ft_last_st, ft_last_d0, ft_last_want, ft_last_got);
+	}
+	return false;
+
+found:
+	(void)ft_read_reg(FT_REG_FW_VER, &fw, 1);
+	(void)ft_read_reg(FT_REG_CHIP_ID2, &id2, 1);
+	printf("SWEET FT: clk=%u mosi=%u miso=%u cs=%u mode=%d -> chip id %#x/%#x fw %#x (crc %#x/%#x)\n",
+	    p.clk, p.mosi, p.miso, p.cs, ft_spi_mode, id, id2, fw, ft_last_want, ft_last_got);
+	return true;
+}
+
+static void
+ft_report(uint32_t mask, const int *x, const int *y)
+{
+	for (unsigned i = 0; i < FT_MAX_FINGERS; ++i) {
+		uint32_t bit = 1u << i;
+		if (mask & bit) {
+			if (!(ft.active & bit) || x[i] != ft.x[i] || y[i] != ft.y[i]) {
+				sweet_hid_touch((int)i, 1, x[i], y[i]);
+			}
+			ft.x[i] = x[i];
+			ft.y[i] = y[i];
+		} else if (ft.active & bit) {
+			sweet_hid_touch((int)i, 0, ft.x[i], ft.y[i]);
+		}
+	}
+	ft.active = mask;
+}
+
+/*
+ * focaltech_core.c fts_read_touchdata reads 62 bytes starting at register 0x01
+ * into point_buf[1..62]:
+ *   buf[0] (= point_buf[1]): palm/gesture status
+ *   buf[1] (= point_buf[2], FTS_TOUCH_POINT_NUM): low nibble = point_num
+ *   buf[2 + 6*i] (= point_buf[3 + 6*i]): 6-byte finger record i
+ */
+static int
+ft_read_touch(void)
+{
+	uint8_t buf[FT_TOUCH_LEN];
+	int x[FT_MAX_FINGERS] = {0}, y[FT_MAX_FINGERS] = {0};
+	uint32_t mask = 0, seen = 0;
+	int err = ft_read_reg(FT_REG_TOUCH, buf, sizeof(buf));
+	if (err) {
+		return err;
+	}
+	unsigned n = buf[1] & 0x0fu, active = 0;
+	if (n == 0x0fu && buf[1] == 0xffu && buf[2] == 0xffu) {
+		return 0; /* idle / all 0xff buffer */
+	}
+	if (n > FT_MAX_FINGERS) {
+		return EIO;
+	}
+	for (unsigned i = 0; i < FT_MAX_FINGERS; ++i) {
+		const uint8_t *p = &buf[2u + 6u * i];
+		unsigned id = p[2] >> 4, event = p[0] >> 6;
+		if (id >= FT_MAX_FINGERS) {
+			break;
+		}
+		if (seen & (1u << id)) {
+			break;
+		}
+		seen |= 1u << id;
+		if (event != 0u && event != 2u) {
+			continue; /* 1 = UP, 3 = none */
+		}
+		unsigned px = ((unsigned)(p[0] & 0x0fu) << 8) | p[1];
+		unsigned py = ((unsigned)(p[2] & 0x0fu) << 8) | p[3];
+		if (ft.touch_logs < 16) {
+			ft.touch_logs++;
+			printf("SWEET FT: raw touch n=%u i=%u id=%u ev=%u px=%u py=%u pre=%#x\n",
+			    n, i, id, event, px, py, p[4]);
+		}
+		if (px >= 1080u || py >= 2400u) {
+			px /= 10u;
+			py /= 10u;
+		}
+		if (px > 1079u) {
+			px = 1079u;
+		}
+		if (py > 2399u) {
+			py = 2399u;
+		}
+		mask |= 1u << id;
+		x[id] = (int)px;
+		y[id] = (int)py;
+		++active;
+	}
+	if (active > 0 && n == 0) {
+		return EIO;
+	}
+	ft_report(mask, x, y);
+	return 0;
+}
+
+static void
+ft_wait(void)
+{
+	uint64_t deadline;
+	clock_interval_to_deadline(8, NSEC_PER_MSEC, &deadline);
+	(void)assert_wait_deadline(&ft_sleep_chan, THREAD_UNINT, deadline);
+	thread_block(THREAD_CONTINUE_NULL);
+}
+
+static void
+ft_thread(void *arg, wait_result_t result)
+{
+	unsigned ticks = 0;
+	(void)arg;
+	(void)result;
+	for (;;) {
+		int irq_low = (ft_pin_in(FT_PIN_IRQ) == 0);
+		if (irq_low || ft.active != 0 || ((ticks++ & 3u) == 0u)) {
+			if (ft_read_touch() == 0) {
+				ft.ok++;
+			} else if ((ft.fail++ % 200u) == 0) {
+				printf("SWEET FT: read errors %u (reads ok %u irq=%d)\n",
+				    ft.fail, ft.ok, !irq_low);
+			}
+		}
+		ft_wait();
+	}
+}
+
+void
+sweet_ft_init(void)
+{
+	int enabled = 0;
+	thread_t thread;
+	if (ft.started) {
+		return;
+	}
+	ft.started = true;
+	(void)PE_parse_boot_argn("sweetft", &enabled, sizeof(enabled));
+	if (!enabled) {
+		printf("SWEET FT: disabled (sweetft=0)\n");
+		return;
+	}
+	ft.tlmm = ml_io_map(FT_TLMM_PA, FT_TLMM_SIZE);
+	if (!ft.tlmm) {
+		printf("SWEET FT: TLMM mapping failed\n");
+		return;
+	}
+	ft_tlmm_selftest();
+	ft.se = ml_io_map(FT_SE_PA, 0x1000);
+	if (ft.se) {
+		ft_se_quiesce();
+	} else {
+		printf("SWEET FT: SE4 mapping failed\n");
+	}
+	ft_power();
+	printf("SWEET FT: probing FTS over bit-banged SPI (pads %u/%u/%u/%u)\n",
+	    FT_PIN_A, FT_PIN_B, FT_PIN_C, FT_PIN_D);
+
+	struct ft_pins found = {0, 0, 0, 0};
+	/*
+	 * Standard Qualcomm QUPv3 SE4 SPI lane assignment:
+	 *   lane 0 (gpio8)  = MISO
+	 *   lane 1 (gpio9)  = MOSI
+	 *   lane 2 (gpio10) = CLK
+	 *   lane 3 (gpio11) = CS
+	 */
+	struct ft_pins qcom_std = {10, 9, 8, 11};
+	struct ft_pins qcom_alt = {10, 8, 9, 11};
+	if (ft_probe_pins(qcom_std, 200, 5)) {
+		found = qcom_std;
+	} else if (ft_probe_pins(qcom_alt, 100, 2)) {
+		found = qcom_alt;
+	}
+
+	static const unsigned pads[4] = {FT_PIN_A, FT_PIN_B, FT_PIN_C, FT_PIN_D};
+	for (unsigned a = 0; a < 4 && !found.clk; ++a) {
+		for (unsigned b = 0; b < 4 && !found.clk; ++b) {
+			if (b == a) {
+				continue;
+			}
+			for (unsigned c = 0; c < 4 && !found.clk; ++c) {
+				if (c == a || c == b) {
+					continue;
+				}
+				unsigned d = 6u - a - b - c;
+				struct ft_pins p;
+				p.clk = pads[a];
+				p.mosi = pads[b];
+				p.miso = pads[c];
+				p.cs = pads[d];
+				if ((p.clk == 10 && p.cs == 11) &&
+				    (p.mosi == 9 || p.mosi == 8)) {
+					continue; /* already tried above */
+				}
+				if (ft_probe_pins(p, 50, 1)) {
+					found = p;
+				}
+			}
+		}
+	}
+	if (!found.clk) {
+		printf("SWEET FT: no chip id from any pin assignment; giving up\n");
+		return;
+	}
+	ft.pins = found;
+	ft.ready = true;
+	printf("SWEET FT: FTS ready (clk=%u mosi=%u miso=%u cs=%u mode=%d)\n",
+	    found.clk, found.mosi, found.miso, found.cs, ft_spi_mode);
+
+	kern_return_t kr = kernel_thread_start(ft_thread, NULL, &thread);
+	if (kr == KERN_SUCCESS) {
+		thread_deallocate(thread);
+	} else {
+		printf("SWEET FT: kernel_thread_start failed %d\n", kr);
+	}
+}
+#endif /* ARM64_BOARD_CONFIG_SWEET */
