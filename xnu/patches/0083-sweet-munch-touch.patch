+	};
+	int ok = 0;
+	for (unsigned i = 0; res && i < sizeof(rails) / sizeof(rails[0]); ++i) {
+		if (strcmp(res, rails[i].name) == 0 &&
+		    mv >= rails[i].lo && mv <= rails[i].hi) {
+			ok = 1;
+			break;
+		}
+	}
+	if (!ok) {
+		printf("SWEET RPMH: no window for %s at %u mV\n", res ? res : "(null)", mv);
 		return EINVAL;
 	}
