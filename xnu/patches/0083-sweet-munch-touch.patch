+/*
+ * SWEET: Focaltech FTS (FT3658U) touch on the K40S (munch / SM8250).
+ *
+ * Supports both:
+ *   1) Native QUPv3 SE4 GENI SPI FIFO (0x00990000, proto=1=SPI loaded by ABL)
+ *   2) Bit-banged SPI on NORTH TLMM tile (0x0f900000, gpio8..11)
+ * with reset=gpio33, irq=gpio39, vddio=gpio69 on SOUTH TLMM tile (0x0f500000).
+ *
+ * All hardware probing runs on ft_thread after root mount and flushes the
+ * persistent UFS console ring before/after each hardware step.
+ */
+#if defined(ARM64_BOARD_CONFIG_SWEET)
+#include <sys/param.h>
+#include <sys/systm.h>
+#include <sys/errno.h>
+#include <kern/clock.h>
+#include <kern/thread.h>
+#include <kern/sched_prim.h>
+#include <machine/machine_routines.h>
+#include <pexpert/pexpert.h>
+
+extern vm_offset_t ml_io_map(vm_offset_t, vm_size_t);
+extern kern_return_t thread_terminate(thread_t);
+extern void sweet_hid_touch(int finger, int down, int x, int y);
+extern int sweet_rpmh_vreg_enable(const char *res, unsigned mv);
+extern void sweet_log_flush(void);
+void sweet_ft_init(void);
+
+#define FT_GCC_PA         0x00100000u
+#define FT_GCC_VOTE       0x00052008u   /* APCS_CLOCK_BRANCH_ENA_VOTE */
+#define FT_GCC_SE4_RCG    0x000174d0u   /* gcc_qupv3_wrap0_s4_clk_src */
+#define FT_GCC_SE4_CBCR   0x000174ccu   /* gcc_qupv3_wrap0_s4_clk */
+
+#define FT_SOUTH_PA       0x0f500000u   /* SM8250 TLMM SOUTH tile */
+#define FT_NORTH_PA       0x0f900000u   /* SM8250 TLMM NORTH tile */
+
+#define FT_SE_PA          0x00990000u   /* GENI SE4, DT soc/spi@990000 */
+#define FT_SE_FORCE_DEF   0x020u
+#define FT_SE_OUT_CTRL    0x024u
+#define FT_SE_CGC_CTRL    0x028u
+#define FT_SE_STATUS      0x040u
+#define FT_SE_M_CLK_CFG   0x048u
+#define FT_SE_FIFO_DIS    0x064u
+#define FT_SE_FW_REV      0x068u
+#define FT_SE_CLK_SEL     0x07cu
+#define FT_SE_CFG_START   0x084u
+#define FT_SE_CPHA        0x224u
+#define FT_SE_LOOPBACK    0x22cu
+#define FT_SE_CPOL        0x230u
+#define FT_SE_DEMUX_INV   0x24cu
+#define FT_SE_DEMUX_SEL   0x250u
+#define FT_SE_BYTE_GRAN   0x254u
+#define FT_SE_DMA_MODE    0x258u
+#define FT_SE_TRANS_CFG   0x25cu
+#define FT_SE_TX_PACK0    0x260u
+#define FT_SE_TX_PACK1    0x264u
+#define FT_SE_WORD_LEN    0x268u
+#define FT_SE_TX_LEN      0x26cu
+#define FT_SE_RX_LEN      0x270u
+#define FT_SE_DLY_CNTRS   0x278u
+#define FT_SE_RX_PACK0    0x284u
+#define FT_SE_RX_PACK1    0x288u
+#define FT_SE_M_CMD       0x600u
+#define FT_SE_M_CMD_CTRL  0x604u
+#define FT_SE_M_IRQ       0x610u
+#define FT_SE_M_IRQ_EN    0x614u
+#define FT_SE_M_IRQ_CLR   0x618u
+#define FT_SE_S_IRQ_EN    0x644u
+#define FT_SE_S_IRQ_CLR   0x648u
+#define FT_SE_TX_FIFO     0x700u
+#define FT_SE_RX_FIFO     0x780u
+#define FT_SE_TX_STATUS   0x800u
+#define FT_SE_RX_STATUS   0x804u
+#define FT_SE_TX_WM       0x80cu
+#define FT_SE_RX_WM       0x810u
+#define FT_SE_RX_RFR_WM   0x814u
+#define FT_SE_IOS         0x908u
+#define FT_SE_GSI_EV_EN   0xe18u
+#define FT_SE_IRQ_EN      0xe1cu
+#define FT_SE_HW_TX       0xe24u
+#define FT_SE_HW_RX       0xe28u
+#define FT_SE_DMA_GEN     0xe30u
+
+#define FT_PACK0          0x0007f8feu
+#define FT_PACK1          0x000ffefeu
+
+#define FT_PULL_NONE      0u
+#define FT_PULL_DOWN      1u
+#define FT_PULL_UP        3u
+
+#define FT_PIN_A          8u            /* NORTH tile: gpio8..11 */
+#define FT_PIN_B          9u
+#define FT_PIN_C          10u
+#define FT_PIN_D          11u
+#define FT_PIN_RESET      33u           /* SOUTH tile: gpio33 */
+#define FT_PIN_IRQ        39u           /* SOUTH tile: gpio39 */
+#define FT_PIN_VDDIO      69u           /* SOUTH tile: gpio69 */
+
+#define FT_REG_TOUCH      0x01u
+#define FT_REG_CHIP_ID2   0x9fu
+#define FT_REG_CHIP_ID    0xa3u
+#define FT_REG_FW_VER     0xa6u
+#define FT_TOUCH_LEN      62u
+#define FT_MAX_FINGERS    10u
+
+#define FT_HDR_LEN        7u
+#define FT_CS_DELAY_US    150u
+
+struct ft_pins {
+	unsigned clk, mosi, miso, cs;
+};
+
+static struct {
+	vm_offset_t gcc, south, north, se;
+	bool started, ready, use_geni;
+	struct ft_pins pins;
+	uint32_t active;
+	int x[FT_MAX_FINGERS], y[FT_MAX_FINGERS];
+	unsigned ok, fail, probe_fails, touch_logs;
+} ft;
+
+static int ft_spi_mode;
+static uint8_t ft_last_st, ft_last_d0;
+static uint16_t ft_last_want, ft_last_got;
+static uint32_t ft_last_irq;
+static int ft_sleep_chan;
+
+static inline uint32_t
+ft_rd(vm_offset_t base, uint32_t off)
+{
+	uint32_t v = *(volatile uint32_t *)(base + off);
+	__asm__ volatile("dmb oshld" ::: "memory");
+	return v;
+}
+
+static inline void
+ft_wr(vm_offset_t base, uint32_t off, uint32_t v)
+{
+	__asm__ volatile("dmb oshst" ::: "memory");
+	*(volatile uint32_t *)(base + off) = v;
+	__asm__ volatile("dsb osh" ::: "memory");
+}
+
+static inline vm_offset_t
+ft_pin_base(unsigned pin)
+{
+	return (pin <= 23u) ? ft.north : ft.south;
+}
+
+static inline uint32_t
+ft_cfg_off(unsigned pin)
+{
+	return (uint32_t)pin * 0x1000u;
+}
+
+static inline uint32_t
+ft_io_off(unsigned pin)
+{
+	return ft_cfg_off(pin) + 4u;
+}
+
+static inline void
+ft_pin_out(unsigned pin, int high)
+{
+	vm_offset_t base = ft_pin_base(pin);
+	if (!base) {
+		return;
+	}
+	ft_wr(base, ft_io_off(pin), high ? 2u : 0u);
+}
+
+static inline int
+ft_pin_in(unsigned pin)
+{
+	vm_offset_t base = ft_pin_base(pin);
+	if (!base) {
+		return 0;
+	}
+	return (ft_rd(base, ft_io_off(pin)) & 1u) ? 1 : 0;
+}
+
+static void
+ft_pad_mux(unsigned pin, unsigned func, int dir_out, unsigned pull, unsigned drv)
+{
+	vm_offset_t base = ft_pin_base(pin);
+	if (!base) {
+		return;
+	}
+	uint32_t off = ft_cfg_off(pin);
+	uint32_t cfg = ft_rd(base, off);
+	cfg &= ~0x3ffu;
+	cfg |= (pull & 3u) | ((func & 0x0fu) << 2) | ((drv & 7u) << 6) |
+	    (dir_out ? 0x200u : 0u);
+	if (cfg & (1u << 11)) {
+		cfg |= (1u << 12);
+	}
+	ft_wr(base, off, cfg);
+}
+
+static void
+ft_pad(unsigned pin, int dir_out, unsigned pull)
+{
+	ft_pad_mux(pin, 0u, dir_out, pull, 3u);
+}
+
+static void
+ft_pad_report(const char *tag, unsigned pin)
+{
+	vm_offset_t base = ft_pin_base(pin);
+	if (!base) {
+		return;
+	}
+	uint32_t cfg = ft_rd(base, ft_cfg_off(pin));
+	uint32_t io = ft_rd(base, ft_io_off(pin));
+	printf("SWEET FT: %s gpio%u cfg=%#x io=%#x\n", tag, pin, cfg, io);
+}
+
+static void
+ft_wait_ms(unsigned ms)
+{
+	uint64_t deadline;
+	clock_interval_to_deadline(ms, NSEC_PER_MSEC, &deadline);
+	(void)assert_wait_deadline(&ft_sleep_chan, THREAD_UNINT, deadline);
+	thread_block(THREAD_CONTINUE_NULL);
+}
+
+static void
+ft_se_abort(void)
+{
+	ft_wr(ft.se, FT_SE_M_CMD_CTRL, 2u);
+	for (unsigned i = 0; i < 2000; ++i) {
+		if (ft_rd(ft.se, FT_SE_M_IRQ) & (1u << 5)) {
+			break;
+		}
+		delay(1);
+	}
+	for (unsigned i = 0; i < 64 && (ft_rd(ft.se, FT_SE_RX_STATUS) & 0x1ffffffu); ++i) {
+		(void)ft_rd(ft.se, FT_SE_RX_FIFO);
+	}
+	ft_wr(ft.se, FT_SE_M_IRQ_CLR, 0xffffffffu);
+}
+
+static bool
+ft_geni_init(void)
+{
+	if (!ft.se) {
+		return false;
+	}
+	if (ft.gcc) {
+		/* Vote wrap0 m_ahb(6), s_ahb(7), core(8), core_2x(9), s4(14) */
+		uint32_t mask = (1u << 6) | (1u << 7) | (1u << 8) | (1u << 9) | (1u << 14);
+		ft_wr(ft.gcc, FT_GCC_VOTE, ft_rd(ft.gcc, FT_GCC_VOTE) | mask);
+		delay(100);
+		printf("SWEET FT: GCC vote=%#x s4_cbcr=%#x s4_rcg=%#x cfg=%#x\n",
+		    ft_rd(ft.gcc, FT_GCC_VOTE), ft_rd(ft.gcc, FT_GCC_SE4_CBCR),
+		    ft_rd(ft.gcc, FT_GCC_SE4_RCG), ft_rd(ft.gcc, FT_GCC_SE4_RCG + 4u));
+		sweet_log_flush();
+	}
+	uint32_t fw = ft_rd(ft.se, FT_SE_FW_REV);
+	uint32_t fdis = ft_rd(ft.se, FT_SE_FIFO_DIS);
+	uint32_t txp = ft_rd(ft.se, FT_SE_HW_TX), rxp = ft_rd(ft.se, FT_SE_HW_RX);
+	uint32_t st = ft_rd(ft.se, FT_SE_STATUS), ios = ft_rd(ft.se, FT_SE_IOS);
+	printf("SWEET FT: SE4 fw=%#x proto=%u fdis=%#x st=%#x txp=%#x rxp=%#x ios=%#x\n",
+	    fw, (fw >> 8) & 0xffu, fdis, st, txp, rxp, ios);
+	sweet_log_flush();
+	if (((fw >> 8) & 0xffu) != 1u || (fdis & 1u)) {
+		printf("SWEET FT: SE4 FIFO SPI not available (proto=%u fdis=%#x)\n",
+		    (fw >> 8) & 0xffu, fdis);
+		sweet_log_flush();
+		return false;
+	}
+	if (st & 1u) {
+		ft_se_abort();
+	}
+	ft_wr(ft.se, FT_SE_GSI_EV_EN, 0);
+	ft_wr(ft.se, FT_SE_IRQ_EN, 0);
+	ft_wr(ft.se, FT_SE_S_IRQ_EN, 0);
+	ft_wr(ft.se, FT_SE_M_IRQ_CLR, 0xffffffffu);
+	ft_wr(ft.se, FT_SE_S_IRQ_CLR, 0xffffffffu);
+	ft_wr(ft.se, FT_SE_DMA_MODE, 0);
+	ft_wr(ft.se, FT_SE_CGC_CTRL, ft_rd(ft.se, FT_SE_CGC_CTRL) | 0x7fu);
+	ft_wr(ft.se, FT_SE_DMA_GEN, ft_rd(ft.se, FT_SE_DMA_GEN) | 0x0fu);
+	ft_wr(ft.se, FT_SE_OUT_CTRL, 0x7fu);
+	ft_wr(ft.se, FT_SE_FORCE_DEF, 1u);
+	/* CLK_SEL=0 (XO 19.2 MHz), div=4 -> 4.8 MHz SPI clock */
+	ft_wr(ft.se, FT_SE_CLK_SEL, 0);
+	ft_wr(ft.se, FT_SE_M_CLK_CFG, (4u << 4) | 1u);
+	/* 8-bit words (8 - MIN_WORD_LEN(4) = 4), 4 bytes per 32-bit FIFO word */
+	ft_wr(ft.se, FT_SE_BYTE_GRAN, 0);
+	ft_wr(ft.se, FT_SE_TX_PACK0, FT_PACK0);
+	ft_wr(ft.se, FT_SE_TX_PACK1, FT_PACK1);
+	ft_wr(ft.se, FT_SE_RX_PACK0, FT_PACK0);
+	ft_wr(ft.se, FT_SE_RX_PACK1, FT_PACK1);
+	ft_wr(ft.se, FT_SE_WORD_LEN, 4u);
+	/* SPI Mode 0, CS 0, normal (no loopback) */
+	ft_wr(ft.se, FT_SE_LOOPBACK, 0);
+	ft_wr(ft.se, FT_SE_DEMUX_SEL, 0);
+	ft_wr(ft.se, FT_SE_CPHA, 0);
+	ft_wr(ft.se, FT_SE_CPOL, 0);
+	ft_wr(ft.se, FT_SE_DEMUX_INV, 0);
+	ft_wr(ft.se, FT_SE_DLY_CNTRS, 0);
+	ft_wr(ft.se, FT_SE_TRANS_CFG, 0);
+	ft_wr(ft.se, FT_SE_TX_WM, 0);
+	ft_wr(ft.se, FT_SE_RX_WM, 0);
+	unsigned rx_depth = (rxp >> 16) & 0x3fu;
+	if (rx_depth > 2u) {
+		ft_wr(ft.se, FT_SE_RX_RFR_WM, rx_depth - 2u);
+	}
+	ft_wr(ft.se, FT_SE_M_IRQ_EN, 0xffffffffu);
+	return true;
+}
+
+static int
+ft_geni_xfer(const uint8_t *tx, uint8_t *rx, unsigned len)
+{
+	if (!len || (ft_rd(ft.se, FT_SE_STATUS) & 1u)) {
+		ft_se_abort();
+	}
+	ft_wr(ft.se, FT_SE_M_IRQ_CLR, 0xffffffffu);
+	ft_wr(ft.se, FT_SE_TRANS_CFG, 0);
+	ft_wr(ft.se, FT_SE_TX_LEN, len);
+	ft_wr(ft.se, FT_SE_RX_LEN, len);
+	/* SPI_FULL_DUPLEX = 3 in bits 31:27 */
+	ft_wr(ft.se, FT_SE_M_CMD, 3u << 27);
+	ft_wr(ft.se, FT_SE_TX_WM, 1u);
+
+	unsigned sent = 0, got = 0;
+	for (unsigned iter = 0; iter < 20000; ++iter) {
+		uint32_t irq = ft_rd(ft.se, FT_SE_M_IRQ);
+		ft_last_irq |= irq;
+
+		/* Drain RX FIFO first so it never overflows */
+		uint32_t rx_st = ft_rd(ft.se, FT_SE_RX_STATUS);
+		uint32_t rx_wc = rx_st & 0x1ffffffu;
+		while (rx_wc-- && got < len) {
+			uint32_t w = ft_rd(ft.se, FT_SE_RX_FIFO);
+			for (unsigned j = 0; j < 4 && got < len; ++j) {
+				uint8_t b = (uint8_t)(w >> (8u * j));
+				if (rx) {
+					rx[got] = b;
+				}
+				got++;
+			}
+		}
+
+		/* Fill TX FIFO while words remain and TX FIFO has space (< 14 words) */
+		while (sent < len && (ft_rd(ft.se, FT_SE_TX_STATUS) & 0xfffffffu) < 14u) {
+			uint32_t w = 0;
+			for (unsigned j = 0; j < 4 && sent < len; ++j) {
+				uint8_t b = tx ? tx[sent] : 0x00u;
+				w |= (uint32_t)b << (8u * j);
+				sent++;
+			}
+			ft_wr(ft.se, FT_SE_TX_FIFO, w);
+		}
+		if (sent >= len) {
+			ft_wr(ft.se, FT_SE_TX_WM, 0);
+		}
+
+		if ((irq & 1u) && got >= len && sent >= len) {
+			ft_wr(ft.se, FT_SE_M_IRQ_CLR, irq);
+			delay(FT_CS_DELAY_US);
+			return 0;
+		}
+		ft_wr(ft.se, FT_SE_M_IRQ_CLR, irq & ((1u << 26) | (1u << 27) | (1u << 30)));
+		delay(1);
+	}
+	ft_se_abort();
+	delay(FT_CS_DELAY_US);
+	return ETIMEDOUT;
+}
+
+static uint8_t
+ft_spi_byte(uint8_t out)
+{
+	uint8_t in = 0;
+	int idle = ft_spi_mode ? 1 : 0;
+	for (int bit = 7; bit >= 0; --bit) {
+		ft_pin_out(ft.pins.mosi, (out >> bit) & 1u);
+		delay(1);
+		ft_pin_out(ft.pins.clk, idle ? 0 : 1);
+		delay(1);
+		in = (uint8_t)((in << 1) | (ft_pin_in(ft.pins.miso) ? 1u : 0u));
+		ft_pin_out(ft.pins.clk, idle ? 1 : 0);
+		delay(1);
+	}
+	return in;
+}
+
+static void
+ft_bb_xfer(const uint8_t *tx, uint8_t *rx, unsigned len)
+{
+	int idle = ft_spi_mode ? 1 : 0;
+	ft_pin_out(ft.pins.clk, idle);
+	ft_pin_out(ft.pins.cs, 0);
+	delay(2);
+	for (unsigned i = 0; i < len; ++i) {
+		uint8_t v = ft_spi_byte(tx ? tx[i] : 0x00u);
+		if (rx) {
+			rx[i] = v;
+		}
+	}
+	delay(2);
+	ft_pin_out(ft.pins.cs, 1);
+	delay(FT_CS_DELAY_US);
+}
+
+static uint16_t
+ft_crc16(const uint8_t *p, unsigned len)
+{
+	uint16_t crc = 0xffffu;
+	for (unsigned i = 0; i < len; ++i) {
+		crc ^= p[i];
+		for (int j = 0; j < 8; ++j) {
+			crc = (crc & 1u) ? (uint16_t)((crc >> 1) ^ 0x8408u) :
+			    (uint16_t)(crc >> 1);
+		}
+	}
+	return crc;
+}
+
+static int
+ft_read_reg(uint8_t addr, uint8_t *data, unsigned len)
+{
+	uint8_t tx[FT_HDR_LEN + 128 + 2], rx[FT_HDR_LEN + 128 + 2];
+	if (len > 128) {
+		return EINVAL;
+	}
+	unsigned txlen = FT_HDR_LEN + len + 2;
+	for (int retry = 0; retry < 3; ++retry) {
+		memset(tx, 0, txlen);
+		memset(rx, 0, txlen);
+		tx[0] = addr;
+		tx[1] = 0xa0u;
+		tx[2] = (uint8_t)(len >> 8);
+		tx[3] = (uint8_t)len;
+		ft_last_irq = 0;
+		if (ft.use_geni) {
+			if (ft_geni_xfer(tx, rx, txlen) != 0) {
+				continue;
+			}
+		} else {
+			ft_bb_xfer(tx, rx, txlen);
+		}
+		ft_last_st = rx[3];
+		ft_last_d0 = rx[FT_HDR_LEN];
+		if ((rx[3] & 0xa0u) != 0u) {
+			delay(FT_CS_DELAY_US);
+			continue;
+		}
+		uint16_t want = ft_crc16(&rx[FT_HDR_LEN], len);
+		uint16_t got = (uint16_t)(rx[FT_HDR_LEN + len] |
+		    ((uint16_t)rx[FT_HDR_LEN + len + 1] << 8));
+		ft_last_want = want;
+		ft_last_got = got;
+		memcpy(data, &rx[FT_HDR_LEN], len);
+		if (want == got) {
+			return 0;
+		}
+		delay(FT_CS_DELAY_US);
+	}
+	return EIO;
+}
+
+static void
+ft_reset(unsigned wait_ms)
+{
+	ft_pin_out(FT_PIN_RESET, 0);
+	delay(5000);
+	ft_pin_out(FT_PIN_RESET, 1);
+	ft_wait_ms(wait_ms);
+}
+
+static bool
+ft_try_geni_probe(const char *tag)
+{
+	uint8_t id = 0, id2 = 0, fw = 0;
+	ft.use_geni = true;
+	ft_reset(200);
+	for (int attempt = 0; attempt < 5; ++attempt) {
+		int err = ft_read_reg(FT_REG_CHIP_ID, &id, 1);
+		printf("SWEET FT: geni(%s) try %d err=%d st=%#x d0=%#x crc=%#x/%#x irq=%#x\n",
+		    tag, attempt, err, ft_last_st, ft_last_d0,
+		    ft_last_want, ft_last_got, ft_last_irq);
+		if ((err == 0 && id != 0x00u && id != 0xffu) ||
+		    ((ft_last_st & 0xa0u) == 0u &&
+		    (ft_last_d0 == 0x56u || ft_last_d0 == 0x36u || ft_last_d0 == 0x88u))) {
+			id = ft_last_d0;
+			(void)ft_read_reg(FT_REG_FW_VER, &fw, 1);
+			(void)ft_read_reg(FT_REG_CHIP_ID2, &id2, 1);
+			printf("SWEET FT: geni(%s) READY chip=%#x/%#x fw=%#x\n",
+			    tag, id, id2, fw);
+			sweet_log_flush();
+			return true;
+		}
+		ft_wait_ms(50);
+	}
+	sweet_log_flush();
+	ft.use_geni = false;
+	return false;
+}
+
+static bool
+ft_probe_pins(struct ft_pins p, unsigned wait_ms, int retries)
+{
+	uint8_t id = 0, id2 = 0, fw = 0;
+	ft.use_geni = false;
+	ft.pins = p;
+	ft_pad(p.clk, 1, FT_PULL_NONE);
+	ft_pad(p.mosi, 1, FT_PULL_NONE);
+	ft_pad(p.cs, 1, FT_PULL_NONE);
+	ft_pad(p.miso, 0, FT_PULL_UP);
+	ft_pin_out(p.clk, 0);
+	ft_pin_out(p.cs, 1);
+
+	ft_reset(wait_ms);
+	for (int attempt = 0; attempt < retries; ++attempt) {
+		for (int mode = 0; mode < 2; ++mode) {
+			ft_spi_mode = mode;
+			int err = ft_read_reg(FT_REG_CHIP_ID, &id, 1);
+			if (err == 0 && id != 0x00u && id != 0xffu) {
+				goto found;
+			}
+			if ((ft_last_st & 0xa0u) == 0u &&
+			    (ft_last_d0 == 0x56u || ft_last_d0 == 0x36u || ft_last_d0 == 0x88u)) {
+				id = ft_last_d0;
+				goto found;
+			}
+			id = 0;
+		}
+		if (attempt + 1 < retries) {
+			ft_wait_ms(50);
+		}
+	}
+	if (ft.probe_fails++ < 8) {
+		printf("SWEET FT: bb try clk=%u mosi=%u miso=%u cs=%u -> "
+		    "st=%#x d0=%#x crc=%#x/%#x\n",
+		    p.clk, p.mosi, p.miso, p.cs,
+		    ft_last_st, ft_last_d0, ft_last_want, ft_last_got);
+	}
+	return false;
+
+found:
+	(void)ft_read_reg(FT_REG_FW_VER, &fw, 1);
+	(void)ft_read_reg(FT_REG_CHIP_ID2, &id2, 1);
+	printf("SWEET FT: bb clk=%u mosi=%u miso=%u cs=%u mode=%d -> chip=%#x/%#x fw=%#x\n",
+	    p.clk, p.mosi, p.miso, p.cs, ft_spi_mode, id, id2, fw);
+	sweet_log_flush();
+	return true;
+}
+
+static void
+ft_report(uint32_t mask, const int *x, const int *y)
+{
+	for (unsigned i = 0; i < FT_MAX_FINGERS; ++i) {
+		uint32_t bit = 1u << i;
+		if (mask & bit) {
+			if (!(ft.active & bit) || x[i] != ft.x[i] || y[i] != ft.y[i]) {
+				sweet_hid_touch((int)i, 1, x[i], y[i]);
+			}
+			ft.x[i] = x[i];
+			ft.y[i] = y[i];
+		} else if (ft.active & bit) {
+			sweet_hid_touch((int)i, 0, ft.x[i], ft.y[i]);
+		}
+	}
+	ft.active = mask;
+}
+
+static int
+ft_read_touch(void)
+{
+	uint8_t buf[FT_TOUCH_LEN];
+	int x[FT_MAX_FINGERS] = {0}, y[FT_MAX_FINGERS] = {0};
+	uint32_t mask = 0, seen = 0;
+	int err = ft_read_reg(FT_REG_TOUCH, buf, sizeof(buf));
+	if (err) {
+		return err;
+	}
+	unsigned n = buf[1] & 0x0fu, active = 0;
+	if (n == 0x0fu && buf[1] == 0xffu && buf[2] == 0xffu) {
+		return 0;
+	}
+	if (n > FT_MAX_FINGERS) {
+		return EIO;
+	}
+	for (unsigned i = 0; i < FT_MAX_FINGERS; ++i) {
+		const uint8_t *p = &buf[2u + 6u * i];
+		unsigned id = p[2] >> 4, event = p[0] >> 6;
+		if (id >= FT_MAX_FINGERS) {
+			break;
+		}
+		if (seen & (1u << id)) {
+			break;
+		}
+		seen |= 1u << id;
+		if (event != 0u && event != 2u) {
+			continue;
+		}
+		unsigned px = ((unsigned)(p[0] & 0x0fu) << 8) | p[1];
+		unsigned py = ((unsigned)(p[2] & 0x0fu) << 8) | p[3];
+		if (ft.touch_logs < 16) {
+			ft.touch_logs++;
+			printf("SWEET FT: raw touch n=%u i=%u id=%u ev=%u px=%u py=%u pre=%#x\n",
+			    n, i, id, event, px, py, p[4]);
+		}
+		if (px >= 1080u || py >= 2400u) {
+			px /= 10u;
+			py /= 10u;
+		}
+		if (px > 1079u) {
+			px = 1079u;
+		}
+		if (py > 2399u) {
+			py = 2399u;
+		}
+		mask |= 1u << id;
+		x[id] = (int)px;
+		y[id] = (int)py;
+		++active;
+	}
+	if (active > 0 && n == 0) {
+		return EIO;
+	}
+	ft_report(mask, x, y);
+	return 0;
+}
+
+static void
+ft_thread(void *arg, wait_result_t result)
+{
+	(void)arg;
+	(void)result;
+
+	ft_wait_ms(6000);
+	printf("SWEET FT: step 1 map GCC + SE4\n");
+	sweet_log_flush();
+	ft.gcc = ml_io_map(FT_GCC_PA, 0x60000);
+	ft.se = ml_io_map(FT_SE_PA, 0x4000);
+	bool geni_ok = ft_geni_init();
+
+	printf("SWEET FT: step 2 enable RPMh rails ldoc1 + ldoc10\n");
+	sweet_log_flush();
+	int e1 = sweet_rpmh_vreg_enable("ldoc1", 1800);
+	int e10 = sweet_rpmh_vreg_enable("ldoc10", 3200);
+	printf("SWEET FT: rails ldoc1=%d ldoc10=%d\n", e1, e10);
+	sweet_log_flush();
+
+	printf("SWEET FT: step 3 map TLMM SOUTH (0x0f500000)\n");
+	sweet_log_flush();
+	ft.south = ml_io_map(FT_SOUTH_PA, 0x50000);
+	if (!ft.south) {
+		printf("SWEET FT: SOUTH mapping failed\n");
+		sweet_log_flush();
+		return;
+	}
+	ft_pad_report("south-before", FT_PIN_RESET);
+	ft_pad_report("south-before", FT_PIN_IRQ);
+	ft_pad_report("south-before", FT_PIN_VDDIO);
+	sweet_log_flush();
+
+	ft_pad(FT_PIN_RESET, 1, FT_PULL_NONE);
+	ft_pin_out(FT_PIN_RESET, 0);
+	ft_pad(FT_PIN_IRQ, 0, FT_PULL_UP);
+	ft_pad(FT_PIN_VDDIO, 1, FT_PULL_NONE);
+	ft_pin_out(FT_PIN_VDDIO, 1);
+	ft_wait_ms(10);
+	ft_pad_report("south-after-vddio", FT_PIN_RESET);
+	ft_pad_report("south-after-vddio", FT_PIN_IRQ);
+	ft_pad_report("south-after-vddio", FT_PIN_VDDIO);
+	sweet_log_flush();
+
+	if (geni_ok && ft_try_geni_probe("pre-north")) {
+		ft.ready = true;
+		goto poll_loop;
+	}
+
+	printf("SWEET FT: step 4 map TLMM NORTH (0x0f900000)\n");
+	sweet_log_flush();
+	ft.north = ml_io_map(FT_NORTH_PA, 0x10000);
+	if (!ft.north) {
+		printf("SWEET FT: NORTH mapping failed\n");
+		sweet_log_flush();
+		return;
+	}
+	for (unsigned p = 8; p <= 11; ++p) {
+		ft_pad_report("north-before", p);
+	}
+	sweet_log_flush();
+
+	if (geni_ok) {
+		/* Mux gpio8..11 to function 1 (qup4), 6mA (drv=2), no-pull */
+		for (unsigned p = 8; p <= 11; ++p) {
+			ft_pad_mux(p, 1u, 0, FT_PULL_NONE, 2u);
+		}
+		for (unsigned p = 8; p <= 11; ++p) {
+			ft_pad_report("north-qup4", p);
+		}
+		sweet_log_flush();
+		if (ft_try_geni_probe("qup4-mux")) {
+			ft.ready = true;
+			goto poll_loop;
+		}
+	}
+
+	printf("SWEET FT: step 5 fallback to bit-banged SPI on gpio8..11\n");
+	sweet_log_flush();
+	if (ft.se) {
+		ft_se_abort();
+		ft_wr(ft.se, FT_SE_OUT_CTRL, 0);
+	}
+	struct ft_pins qcom_std = {10, 9, 8, 11};
+	struct ft_pins qcom_alt = {10, 8, 9, 11};
+	if (ft_probe_pins(qcom_std, 200, 3)) {
+		ft.ready = true;
+		goto poll_loop;
+	}
+	if (ft_probe_pins(qcom_alt, 100, 2)) {
+		ft.ready = true;
+		goto poll_loop;
+	}
+	static const unsigned pads[4] = {FT_PIN_A, FT_PIN_B, FT_PIN_C, FT_PIN_D};
+	for (unsigned a = 0; a < 4 && !ft.ready; ++a) {
+		for (unsigned b = 0; b < 4 && !ft.ready; ++b) {
+			if (b == a) {
+				continue;
+			}
+			for (unsigned c = 0; c < 4 && !ft.ready; ++c) {
+				if (c == a || c == b) {
+					continue;
+				}
+				unsigned d = 6u - a - b - c;
+				struct ft_pins p = {pads[a], pads[b], pads[c], pads[d]};
+				if (p.clk == 10 && p.cs == 11 && (p.mosi == 9 || p.mosi == 8)) {
+					continue;
+				}
+				if (ft_probe_pins(p, 50, 1)) {
+					ft.ready = true;
+				}
+			}
+		}
+	}
+	sweet_log_flush();
+	if (!ft.ready) {
+		printf("SWEET FT: no chip id from GENI or bit-bang; giving up\n");
+		sweet_log_flush();
+		return;
+	}
+
+poll_loop:
+	printf("SWEET FT: entering touch poll loop (use_geni=%d)\n", ft.use_geni);
+	sweet_log_flush();
+	unsigned ticks = 0;
+	for (;;) {
+		int irq_low = (ft_pin_in(FT_PIN_IRQ) == 0);
+		if (irq_low || ft.active != 0 || ((ticks++ & 3u) == 0u)) {
+			if (ft_read_touch() == 0) {
+				ft.ok++;
+			} else if ((ft.fail++ % 200u) == 0) {
+				printf("SWEET FT: read errors %u (reads ok %u irq=%d)\n",
+				    ft.fail, ft.ok, !irq_low);
+			}
+		}
+		ft_wait_ms(8);
+	}
+}
+
+void
+sweet_ft_init(void)
+{
+	int enabled = 0;
+	thread_t thread;
+	if (ft.started) {
+		return;
+	}
+	ft.started = true;
+	(void)PE_parse_boot_argn("sweetft", &enabled, sizeof(enabled));
+	if (!enabled) {
+		printf("SWEET FT: disabled (sweetft=0)\n");
+		return;
+	}
+	kern_return_t kr = kernel_thread_start(ft_thread, NULL, &thread);
+	if (kr == KERN_SUCCESS) {
+		thread_deallocate(thread);
+	} else {
+		printf("SWEET FT: kernel_thread_start failed %d\n", kr);
+	}
+}
+#endif /* ARM64_BOARD_CONFIG_SWEET */
