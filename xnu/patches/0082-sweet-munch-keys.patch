+static void
+keys_probe_apids(uint32_t count)
+{
+	for (uint32_t i = 0; i < count; ++i) {
+		uint32_t map = keys_rd(keys_core, 0x900u + 4u * i);
+		if (map == 0) {
+			continue;
+		}
+		uint16_t ppid = (uint16_t)((map >> 8) & 0xfffu);
+		uint32_t owner = keys_rd(keys_cnfg, 0x700u + 4u * i) & 7u;
+		uint16_t pid = ppid & 0xffu;
+		if (ppid == 0x008u || (pid >= 0xc0u && pid <= 0xcbu)) {
+			printf("SWEET KEYS: map apid=%u ppid=%#x owner=%u\n",
+			    i, ppid, owner);
+		}
+	}
+	sweet_log_flush();
+
+	static const uint16_t cands[] = {
+		0x0c5u, /* PM8150 GPIO6 = munch key_vol_up */
+		0x0c6u, /* PM8150 GPIO7 = munch key_confirm */
+		0x0c0u, /* PM8150 GPIO1 = munch key_home */
+		0x0c1u, 0x0c2u, 0x0c3u, 0x0c4u, 0x0c7u, 0x0c8u, 0x0c9u,
+		0x4c1u, /* PM6150L GPIO2 = sweet vol_up */
+		0x4c0u,
+	};
+	for (unsigned idx = 0; idx < sizeof(cands) / sizeof(cands[0]); ++idx) {
+		uint16_t ppid = cands[idx];
+		uint16_t apid = keys_find_apps_apid(ppid, count);
+		if (apid == KEYS_NO_APID) {
+			continue;
+		}
+		uint8_t rt = 0, md = 0, en = 0, st = 0;
+		bool rok = keys_read(apid, 0x10, &rt);
+		bool mok = keys_read(apid, 0x40, &md);
+		bool eok = keys_read(apid, 0x46, &en);
+		bool sok = keys_read(apid, 0x05, &st);
+		printf("SWEET KEYS: probe ppid=%#x apid=%u rt=%#x/%d mode=%#x/%d en=%#x/%d sub=%#x/%d\n",
+		    ppid, apid, rt, rok, md, mok, en, eok, st, sok);
+		if (rok && mok && eok && keys_nwatch < KEYS_MAX_WATCH) {
+			struct keys_watch *w = &keys_watched[keys_nwatch++];
+			w->ppid = ppid;
+			w->apid = apid;
+			w->idle_bit = (uint8_t)(rt & 1u);
+			w->mode = md;
+			w->en = en;
+		}
+	}
+	sweet_log_flush();
+}
