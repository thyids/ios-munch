 		}
@@ -154,8 +170,23 @@
 	keys_pon_apid = keys_find_apid(0x008, count);
 	keys_gpio_apid = keys_find_apid(0x4c1, count);
 	uint8_t pon = 0, gpio = 0, mode = 0, en = 0, subtype = 0;
+	/* munch (K40S): volume-up is PM8150 GPIO6, not PM6150L GPIO1. Prefer it
+	 * whenever its block reports an input-enabled pin; otherwise keep sweet's
+	 * GPIO1 path untouched. */
+	{
+		uint8_t g6 = 0, m6 = 0, e6 = 0;
+		bool rt6 = keys_read(keys_gpio_apid, KEYS_GPIO6_RT, &g6);
