+		    !!(pon & 2u)};
+		if (((keys_polls++) % 250u) == 0u) {
+			printf("SWEET KEYS: pon=%#x gpio%#x=%#x gpio%#x=%#x gpio%#x=%#x\n",
+			    pon, keys_gpio_rt, gpio, KEYS_GPIO6_RT, g6, KEYS_GPIO7_RT, g7);
+		}
 		if (!pok || !gok) {
