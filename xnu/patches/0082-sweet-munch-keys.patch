+static bool
+keys_write_byte(vm_offset_t ch, uint8_t reg, uint8_t val)
+{
+	uint32_t cmd = (0u << 27) | ((uint32_t)reg << 4) | 0u; /* EXT_WRITEL, 1 byte */
+	__asm__ volatile("dmb oshst" ::: "memory");
+	*(volatile uint32_t *)(ch + 0x10u) = (uint32_t)val;
+	__asm__ volatile("dmb oshst" ::: "memory");
+	*(volatile uint32_t *)(ch + 0x00u) = cmd;
+	__asm__ volatile("dsb osh" ::: "memory");
+	for (unsigned i = 0; i < 1000; ++i) {
+		uint32_t st = keys_rd(ch, 0x08u);
+		if (st & 1u) {
+			return (st & 0x0eu) == 0u;
+		}
+		delay(1);
+	}
+	return false;
+}
